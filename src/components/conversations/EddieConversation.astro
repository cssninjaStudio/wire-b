---
import Reactions from '../misc/Reactions.astro'
---

<div x-show="activeConversation === 'conversation-5'" id="conversation-5" class="chat-body-inner is-multiple has-slimscroll">
  <div class="date-divider">
    <hr class="date-divider-line" />
    <span class="date-divider-text">Monday</span>
  </div>

  <div x-show="isConversationLoading" class="shadow-dom">
    <div class="chat-message is-received is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>

    <div class="chat-message is-received is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>

    <div class="chat-message is-sent is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>

    <div class="chat-message is-received is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>
  </div>

  <div x-show="!isConversationLoading" class="true-dom">
    <div class="chat-message is-received">
      <img src="/img/avatars/eddie.jpg" alt="" />
      <div class="message-block">
        <span>4:55pm</span>
        <div class="message-text">Hey folks, what's up?</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-received">
      <img src="/img/avatars/eddie.jpg" alt="" />
      <div class="message-block">
        <span>4:56pm</span>
        <div class="message-text">Iam coming to LA tomorrow. Interested in having lunch?</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-sent">
      <img src="/img/avatars/helen.jpg" alt="" />
      <div class="message-block">
        <span>5:21pm</span>
        <div class="message-text">Hey mate, it's been a while. Sure I would love to.</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-received">
      <img src="/img/avatars/eddie.jpg" alt="" />
      <div class="message-block">
        <span>5:27pm</span>
        <div class="message-text">Ok. Let's say i pick you up at 12:30 at work, works?</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-received">
      <img src="/img/avatars/madeline.jpg" alt="" />
      <div class="message-block">
        <span>5:29pm</span>
        <div class="message-text">Hey Eddie! What's going on? Of course Iam in</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-sent">
      <img src="/img/avatars/helen.jpg" alt="" />
      <div class="message-block">
        <span>5:43pm</span>
        <div class="message-text">Yup, that works great.</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-received">
      <img src="/img/avatars/alec.jpg" alt="" />
      <div class="message-block">
        <span>5:44pm</span>
        <div class="message-text">Yup, iam in!</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-sent">
      <img src="/img/avatars/helen.jpg" alt="" />
      <div class="message-block">
        <span>5:44pm</span>
        <div class="message-text">And yeah Eddie, don't forget to bring some of my favourite cheese cake.</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-received">
      <img src="/img/avatars/eddie.jpg" alt="" />
      <div class="message-block">
        <span>5:27pm</span>
        <div class="message-text">No worries</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>
  </div>
</div>
