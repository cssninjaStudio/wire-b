---
import Reactions from '../misc/Reactions.astro'
---

<div x-show="activeConversation === 'conversation-8'" id="conversation-8" class="chat-body-inner has-slimscroll">
  <div class="date-divider">
    <hr class="date-divider-line" />
    <span class="date-divider-text">September 28</span>
  </div>

  <div x-show="isConversationLoading" class="shadow-dom">
    <div class="chat-message is-received is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>

    <div class="chat-message is-received is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>

    <div class="chat-message is-sent is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>

    <div class="chat-message is-received is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>
  </div>

  <div x-show="!isConversationLoading" class="true-dom">
    <div class="chat-message is-sent">
      <img src="/img/avatars/helen.jpg" alt="" />
      <div class="message-block">
        <span>11:53am</span>
        <div class="message-text">Walter, i forgot my folder at your place yesterday.</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-sent">
      <img src="/img/avatars/helen.jpg" alt="" />
      <div class="message-block">
        <span>11:53am</span>
        <div class="message-text">I need it badly, it's work stuff.</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-received">
      <img src="/img/avatars/walter.jpg" alt="" />
      <div class="message-block">
        <span>12:19pm</span>
        <div class="message-text">Yeah i noticed. I'll drop it in half an hour at your office.</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>
  </div>
</div>
