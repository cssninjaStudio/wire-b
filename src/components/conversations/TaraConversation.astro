---
import Reactions from '../misc/Reactions.astro'
---

<div x-show="activeConversation === 'conversation-7'" id="conversation-7" class="chat-body-inner is-multiple has-slimscroll">
  <div class="date-divider">
    <hr class="date-divider-line" />
    <span class="date-divider-text">Today</span>
  </div>

  <div x-show="isConversationLoading" class="shadow-dom">
    <div class="chat-message is-received is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>

    <div class="chat-message is-received is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>

    <div class="chat-message is-sent is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>

    <div class="chat-message is-received is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>
  </div>

  <div x-show="!isConversationLoading" class="true-dom">
    <div class="chat-message is-received">
      <img src="/img/avatars/tara.jpg" alt="" />
      <div class="message-block">
        <span>2:01pm</span>
        <div class="message-text">Hello Helen, did you read my proposal?</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-received">
      <img src="/img/avatars/tara.jpg" alt="" />
      <div class="message-block">
        <span>2:01pm</span>
        <div class="message-text">Didn't hear from you since i sent it.</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-sent">
      <img src="/img/avatars/helen.jpg" alt="" />
      <div class="message-block">
        <span>2:02pm</span>
        <div class="message-text">Hello Tara, Iam really sorry, Iam so busy recently, but i had the time to read it.</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-received">
      <img src="/img/avatars/tara.jpg" alt="" />
      <div class="message-block">
        <span>2:04pm</span>
        <div class="message-text">And what did you think about it?</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-sent">
      <img src="/img/avatars/helen.jpg" alt="" />
      <div class="message-block">
        <span>2:05pm</span>
        <div class="message-text">Actually it's quite good, there might be some small changes but overall it's great.</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-sent">
      <img src="/img/avatars/helen.jpg" alt="" />
      <div class="message-block">
        <span>2:07pm</span>
        <div class="message-text">I think that i can give it to my boss at this stage. Kristie will tak it from here.</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-received has-reactions">
      <img src="/img/avatars/kristie.jpg" alt="" />
      <div class="message-block">
        <span>2:09pm</span>
        <div class="message-text">Yeah, let me know if there is something you need Tara</div>

        <!--Reactions buttons-->
        <Reactions />

        <!--Message reactions-->
        <div class="reaction-counts">
          <div class="reaction-count">
            <span>👍</span>
            <span>2</span>
          </div>
        </div>
      </div>
    </div>

    <div class="chat-message is-received">
      <img src="/img/avatars/tara.jpg" alt="" />
      <div class="message-block">
        <span>2:09pm</span>
        <div class="message-text">Crossing fingers then</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-received">
      <img src="/img/avatars/tara.jpg" alt="" />
      <div class="message-block">
        <span>2:10pm</span>
        <div class="message-text">Sounds good, thanks Kristie</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>
  </div>
</div>
