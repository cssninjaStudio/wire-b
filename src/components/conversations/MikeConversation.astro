---
import Reactions from '../misc/Reactions.astro'
---

<div
  x-show="activeConversation === 'conversation-1'"
  id="conversation-1"
  class="chat-body-inner is-multiple has-slimscroll"
>
  <div class="date-divider">
    <hr class="date-divider-line" />
    <span class="date-divider-text">Today</span>
  </div>

  <div x-show="isConversationLoading" class="shadow-dom">
    <div class="chat-message is-received is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>

    <div class="chat-message is-received is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>

    <div class="chat-message is-sent is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>

    <div class="chat-message is-received is-placeloader">
      <div class="img loads"></div>
      <div class="message-block">
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
        <div class="content-shape loads"></div>
      </div>
    </div>
  </div>

  <div x-show="!isConversationLoading" class="true-dom">
    <div class="chat-message is-received has-reactions">
      <img src="/img/avatars/mike.jpg" alt="" />
      <div class="message-block">
        <span>8:03am</span>
        <div class="message-text">
          Hi Helen! I made a new design, and i wanted to show it to you.
        </div>

        <!--Reactions buttons-->
        <Reactions />

        <!--Message reactions-->
        <div class="reaction-counts">
          <div class="reaction-count">
            <span>👍</span>
            <span>2</span>
          </div>
        </div>
      </div>
    </div>

    <div class="chat-message is-received">
      <img src="/img/avatars/mike.jpg" alt="" />
      <div class="message-block">
        <span>8:03am</span>
        <div class="message-text">
          It's quite clean and it's inspired from Dashkit.
        </div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-sent">
      <img src="/img/avatars/helen.jpg" alt="" />
      <div class="message-block">
        <span>8:12am</span>
        <div class="message-text">Oh really??! I want to see that.</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-received">
      <img src="/img/avatars/ben.jpg" alt="" />
      <div class="message-block">
        <span>8:12am</span>
        <div class="message-text">Well I want to see that too! 🎉🎉🎉</div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-received has-reactions">
      <img src="/img/avatars/mike.jpg" alt="" />
      <div class="message-block">
        <span>8:13am</span>
        <div class="message-text">You bet you want to see it!</div>

        <!--Message reactions-->
        <div class="reaction-counts">
          <div class="reaction-count">
            <span>😄</span>
            <span>2</span>
          </div>
        </div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-received">
      <img src="/img/avatars/walter.jpg" alt="" />
      <div class="message-block">
        <span>8:12am</span>
        <div class="message-text">
          Does it include the widgets we were discussing the other day? Could
          come in handy
        </div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-sent has-reactions">
      <img src="/img/avatars/helen.jpg" alt="" />
      <div class="message-block">
        <span>8:17am</span>
        <div class="message-text">
          Great to hear it. Just send me the PSD files so i can have a look at
          it.
        </div>

        <!--Message reactions-->
        <div class="reaction-counts">
          <div class="reaction-count">
            <span>👍</span>
            <span>1</span>
          </div>
        </div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-sent">
      <img src="/img/avatars/helen.jpg" alt="" />
      <div class="message-block">
        <span>8:18am</span>
        <div class="message-text">
          And if you have a prototype, you can also send me the link to it.
        </div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-received has-reactions">
      <img src="/img/avatars/walter.jpg" alt="" />
      <div class="message-block">
        <span>8:23am</span>
        <div class="message-text">
          I also need it because I need to start mocking things up. Aaron is
          expecting the prototype for next week.
        </div>

        <!--Message reactions-->
        <div class="reaction-counts">
          <div class="reaction-count">
            <span>👊</span>
            <span>1</span>
          </div>
          <div class="reaction-count">
            <span>👍</span>
            <span>1</span>
          </div>
        </div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>

    <div class="chat-message is-sent">
      <img src="/img/avatars/helen.jpg" alt="" />
      <div class="message-block">
        <span>8:29am</span>
        <div class="message-text">
          Oh my god! Is the deadline really next week? I feel there's still a
          lot to do on this.
        </div>

        <!--Reactions buttons-->
        <Reactions />
      </div>
    </div>
  </div>
</div>
