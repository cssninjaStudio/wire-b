---
import MenuDropdown from "../components/dropdowns/MenuDropdown.astro";
import SettingsDropdown from "../components/dropdowns/SettingsDropdown.astro";
import AccountDropdown from "../components/dropdowns/AccountDropdown.astro";
---

<div
  class="chat-nav"
  :class="{
        'is-mobile-active': layoutMobileActive,
        '': !layoutMobileActive
    }"
>
  <div class="nav-start">
    <div class="nav-item burger-wrapper">
      <button
        class="menu-icon v-5"
        @click="toggleMobileLayout()"
        class="menu-icon v-4"
        :class="{
                    'is-open': layoutMobileActive,
                    '': !layoutMobileActive
                }"
      >
        <span></span>
      </button>
    </div>

    <div class="recipient-block">
      <div id="navbar-participants" class="avatars">
        <div class="avatar-container">
          <img class="user-avatar" src="/img/avatars/mike.jpg" alt="" />
        </div>
        <div class="avatar-container">
          <img class="user-avatar" src="/img/avatars/helen.jpg" alt="" />
        </div>
        <div class="avatar-container">
          <img class="user-avatar" src="/img/avatars/ben.jpg" alt="" />
        </div>
        <div class="avatar-container">
          <img class="user-avatar" src="/img/avatars/walter.jpg" alt="" />
        </div>
      </div>
      <div class="username">
        <span id="navbar-participant-name">Mike Baggio</span>
        <span>and <var id="navbar-participants-count">3</var> more</span>
      </div>
    </div>
  </div>
  <div class="nav-end">
    <div class="toggle-wrapper">
      <div class="ninja-toggle">
        <input @click="toggleTheme()" id="theme-toggle" type="checkbox" />
        <label for="theme-toggle" class="no-margin">
          <span class="track">
            <span class="track-inner"></span>
            <span class="track-knob">
              <i class="sun iconify" data-icon="lucide:sun"></i>
              <i class="moon iconify" data-icon="lucide:moon"></i>
            </span>
          </span>
        </label>
      </div>
    </div>

    <!-- More dropdown -->
    <MenuDropdown />

    <!-- Settings icon dropdown -->
    <SettingsDropdown />

    <div class="chat-search">
      <div class="form-group has-icon">
        <input type="text" class="form-control" placeholder="Search messages" />
        <div class="form-icon">
          <i class="iconify" data-icon="lucide:search"></i>
        </div>
      </div>
    </div>

    <div class="chat-nav-item is-spacer is-hidden-mobile"></div>

    <!-- User dropdown -->
    <AccountDropdown />

    <div class="nav-item burger-wrapper-right">
      <button
        @click="toggleMobileSidebar()"
        class="menu-icon v-4"
        :class="{
            'is-open': sidebarMobileOpen,
            '': !sidebarMobileOpen
        }"
      >
        <span></span>
      </button>
    </div>
  </div>
</div>
