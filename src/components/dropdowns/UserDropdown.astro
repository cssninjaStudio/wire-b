<div class="dropdown details-dropdown is-spaced dropdown-trigger">
  <button data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
    <div class="action-icon">
      <i class="material-icons">more_vert</i>
    </div>
  </button>
  <div class="dropdown-menu" role="menu">
    <div class="dropdown-content">
      <div class="dropdown-item is-header">
        <h5>User actions</h5>
      </div>
      <a href="#" class="dropdown-item">
        <div class="media">
          <i class="iconify" data-icon="lucide:eye"></i>
          <div class="media-content">
            <h3>View profile</h3>
            <small>View this user's profile.</small>
          </div>
        </div>
      </a>
      <a class="dropdown-item">
        <div class="media">
          <i class="iconify" data-icon="lucide:mail"></i>
          <div class="media-content">
            <h3>Send message</h3>
            <small>Send a message to the user's inbox.</small>
          </div>
        </div>
      </a>
      <hr class="dropdown-divider" />
      <a class="dropdown-item">
        <div class="media">
          <i class="iconify" data-icon="lucide:share-2"></i>
          <div class="media-content">
            <h3>Share profile</h3>
            <small>Share this user's profile.</small>
          </div>
        </div>
      </a>
      <a class="dropdown-item">
        <div class="media">
          <i class="iconify" data-icon="lucide:slash"></i>
          <div class="media-content">
            <h3>Block user</h3>
            <small>Block this user permanently.</small>
          </div>
        </div>
      </a>
    </div>
  </div>
</div>
