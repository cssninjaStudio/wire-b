<div x-ref="menudrop" @click.away="$refs.menudrop.classList.remove('is-active')" class="dropdown is-spaced is-right dropdown-trigger">
  <button @click="$refs.menudrop.classList.add('is-active')" aria-haspopup="true" aria-expanded="false">
    <a class="chat-nav-item is-icon">
      <iconify-icon class="iconify" icon="lucide:more-vertical"></iconify-icon>
    </a>
  </button>
  <div class="dropdown-menu" role="menu">
    <div class="dropdown-content">
      <div class="dropdown-item is-header">
        <h5>Menu</h5>
      </div>
      <a href="#" class="dropdown-item">
        <div class="media">
          <iconify-icon class="iconify" icon="lucide:file-text"></iconify-icon>
          <div class="media-content">
            <h3>Files</h3>
            <small>View all your files.</small>
          </div>
        </div>
      </a>
      <a class="dropdown-item">
        <div class="media">
          <iconify-icon class="iconify" icon="lucide:users"></iconify-icon>
          <div class="media-content">
            <h3>Users</h3>
            <small>View all users you're talking to.</small>
          </div>
        </div>
      </a>
      <hr class="dropdown-divider" />
      <a class="dropdown-item">
        <div class="media">
          <iconify-icon class="iconify" icon="lucide:gift"></iconify-icon>
          <div class="media-content">
            <h3>Daily bonus</h3>
            <small>Get your daily bonus.</small>
          </div>
        </div>
      </a>
      <a class="dropdown-item">
        <div class="media">
          <iconify-icon class="iconify" icon="lucide:download-cloud"></iconify-icon>
          <div class="media-content">
            <h3>Downloads</h3>
            <small>See all your downloads.</small>
          </div>
        </div>
      </a>
      <hr class="dropdown-divider" />
      <a class="dropdown-item">
        <div class="media">
          <iconify-icon class="iconify" icon="lucide:life-buoy"></iconify-icon>
          <div class="media-content">
            <h3>Support</h3>
            <small>Reach our support team.</small>
          </div>
        </div>
      </a>
    </div>
  </div>
</div>
